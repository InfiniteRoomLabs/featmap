# Vendored upstream CRA 4 has many ancient transitives that pre-date npm
# provenance attestation. Per-project bounded exceptions.
#
# semver: many versions in the CRA 4 tree lack provenance (multiple majors,
#   dozens of minors). Exclude all versions for this project only.
trust-policy-exclude[]=semver

# CRA 4 pins @babel/core 7.12.3; newer @babel/* plugins resolved via the lock
# file want >=7.13. Upstream's own lockfile shipped under npm with non-strict
# peer deps. Disable strict peer enforcement for this vendored repo only.
strict-peer-dependencies=false

# pnpm-lock.yaml was generated with autoInstallPeers:false (the global hardening
# default). Pin it here so `pnpm install --frozen-lockfile` matches the lockfile
# in any environment -- without this, a container/CI lacking the global pnpm rc
# defaults to autoInstallPeers:true and fails with ERR_PNPM_LOCKFILE_CONFIG_MISMATCH.
auto-install-peers=false
